---
title: QBFT consensus Event BLOCK_TIMER_EXPIRY
config:
  htmlLabels: false

  look: handDrawn
  theme: redux-dark-color

---
sequenceDiagram
  autonumber
  participant BftProcessor as BftProcessor.java
  participant EventMultiplexer as EventMultiplexer.java
  participant BftEventHandlerAdaptor as BftEventHandlerAdaptor.java
  participant QbftController as QbftController.java
  participant QbftBlockHeightManager as QbftBlockHeightManager.java
  participant QbftFinalState as QbftFinalState.java
  participant RoundChangeManager as RoundChangeManager.java
  participant QbftRound as QbftRound.java
  participant RoundState as RoundState.java
  participant QbftBlockCreatorAdaptor as QbftBlockCreatorAdaptor.java
  participant MessageFactory as MessageFactory.java
  participant QbftMessageTransmitter as QbftMessageTransmitter.java
  participant UniqueMessageMulticaster as UniqueMessageMulticaster.java
  participant OtherValidators as Other Validators

  create participant BftEventQueue@{ type : queue } as BftEventQueue.java
  BftProcessor ->> BftEventQueue: start()
  activate BftProcessor
  Note over BftEventQueue: BlockingLinkedQueue
  loop while not bftProcessor shutdown is set true
    BftProcessor ->>BftEventQueue: poll(500ms timeout) return BftEvent
    BftEventQueue ->> BftProcessor: BftEvent or null
    opt if BftEvent is present 
      BftProcessor ->> EventMultiplexer: handleBftEvent(BftEvent)
      alt BftEvents.Type == BLOCK_TIMER_EXPIRY
        EventMultiplexer ->> BftEventHandlerAdaptor: handleBlockTimerExpiry(blockTimerExpiry);
        BftEventHandlerAdaptor ->> QbftController: handleBlockTimerExpiry(blockTimerExpiry);
        break return
          Note over QbftController: Discard block timer events <br/>that target a height already on the blockchain <br/>(e.g., block was imported via peer sync while the timer was pending). <br/>Same guard as handleRoundExpiry.
        end
        opt if messsage is for current height 
          QbftController ->> QbftBlockHeightManager: handleBlockTimerExpiry(ConsensusRoundIdentifier)
          break current round is presnet 
            Note over QbftBlockHeightManager: It is possible for the block timer to take longer than it should due to the precision of<br/>the timer in Java and the OS. This means occasionally the proposal can arrive before the<br/>block timer expiry and hence the round has already been set. There is no negative impact<br/>on the protocol in this case.
          end
        end

        QbftBlockHeightManager ->> QbftBlockHeightManager: startNewRound(0)
        QbftBlockHeightManager ->> RoundChangeManager: discardRoundsPriorTo(ConsensusRoundIdentifier)

        QbftBlockHeightManager ->> QbftBlockHeightManager: logValidatorChanges(QbftRound)
        opt if nodes round identifier matches the qbft message round identifier
          QbftBlockHeightManager ->> QbftBlockHeightManager: buildBlockAndMaybePropose(ConsensusRoundIdentifier, QbftRound)
          Note over QbftBlockHeightManager: mining will be checked against round 0 as the current round is initialised to 0 above
          break if local node is NOT proposer for round
            QbftBlockHeightManager ->> QbftBlockHeightManager: wouldCreateEmptyBlock(QbftRound)
            QbftBlockHeightManager ->> QbftRound: createBlock()
            QbftRound ->> QbftBlockCreatorAdaptor: createBlock()
            Note over QbftBlockCreatorAdaptor: creates and returns empty block
            opt if within empty block period and wouldCreateEmptyBlock(QbftRound)
              QbftBlockHeightManager ->> QbftFinalState: getBlockTimer().resetTimerForEmptyBlock()
              QbftBlockHeightManager ->> QbftFinalState: getRoundTimer().cancelTimer()
              Note over QbftBlockHeightManager: set currentRound as empty
            end
            Note over QbftBlockHeightManager: This node is not a proposer so it will not send a proposal and return
          end
          QbftBlockHeightManager ->> QbftRound: createBlock()
          QbftRound ->> QbftBlockCreatorAdaptor: createBlock()
          alt if block is not empty
            QbftBlockHeightManager ->> QbftRound: updateStateWithProposalAndTransmit(..)
            QbftRound ->> MessageFactory: createProposal()
            MessageFactory ->> QbftRound: return Proposal
            QbftRound ->> QbftMessageTransmitter: multicastProposal()
            QbftMessageTransmitter --> MessageFactory: createProposal()
            MessageFactory ->> QbftMessageTransmitter: returns Proposal
            QbftMessageTransmitter->> UniqueMessageMulticaster: send(Proposal)
            UniqueMessageMulticaster-->> OtherValidators: MESSAGE-PROPOSAL
            QbftRound ->> QbftRound: updateStateWithProposedBlock(Proposal)
            QbftRound ->> RoundState: setProposedBlock(Proposal)
            Note over RoundState: update prepared and committed values
            opt if block accepted
              QbftRound ->> RoundState: getProposedBlock()
              RoundState ->> QbftRound: returns QbftBlock or null
              QbftRound ->QbftRound: createCommitSeal(QbftBlock) return SECPSignature 
              opt There are times handling a proposed block is enough to enter prepared.
                QbftRound->>QbftMessageTransmitter: multicastCommit(ConsensusRoundIdentifier, Hash, SECPSignature)
              end
              Note over QbftRound: can automatically add our commit message to the roundState <br/>cannot create a prepare message here, <br/>as it may be our proposal, <br/>and thus we cannot also prepare
              QbftRound ->> MessageFactory: createCommit(ConsensusRoundIdentifier, Hash, SECPSignature)
              MessageFactory ->> QbftRound: return Commit
              QbftRound ->> RoundState: addCommitMessage(Commit)
              opt It is possible sufficient commit seals are now available and the block should be imported
                QbftRound ->> QbftRound: importBlockToChain()
                QbftRound ->> QbftRound: notifyNewBlockListeneres(QbftBlock)
              end
            end
            QbftRound ->> QbftRound: sendPrepare(QbftBlock)
            QbftRound ->> MessageFactory: createPrepare(ConsensusRoundIdentifier, Hash)
            MessageFactory ->>QbftRound: creates a Prepare message
            QbftRound ->> QbftRound: peerIsPrepared(Prepare)
            RoundState ->> RoundState: addPrepareMessage(Prepare)
            QbftRound ->>QbftMessageTransmitter:multicastCommit(ConsensusRoundIdentifier, Hash, SECPSignature)
            QbftMessageTransmitter ->> UniqueMessageMulticaster: send()
            UniqueMessageMulticaster -->> OtherValidators: MESSAGE-COMMIT
            QbftRound ->>QbftMessageTransmitter:multicastPrepare(ConsensusRoundIdentifier, Hash)
            QbftMessageTransmitter ->> UniqueMessageMulticaster: send()
            UniqueMessageMulticaster -->> OtherValidators: MESSAGE-PREPARE
          else block is empty
            alt if empty block expired 
              QbftBlockHeightManager ->> QbftRound: updateStateWithProposalAndTransmit(..)
              QbftRound ->> MessageFactory: createProposal()
              MessageFactory ->> QbftRound: return Proposal
              QbftRound ->> QbftMessageTransmitter: multicastProposal()
              QbftMessageTransmitter --> MessageFactory: createProposal()
              MessageFactory ->> QbftMessageTransmitter: returns Proposal
              QbftMessageTransmitter->> UniqueMessageMulticaster: send(Proposal)
              UniqueMessageMulticaster-->> OtherValidators: MESSAGE-PROPOSAL
              QbftRound ->> QbftRound: updateStateWithProposedBlock(Proposal)
              QbftRound ->> RoundState: setProposedBlock(Proposal)
              Note over RoundState: update prepared and committed values
              opt if block accepted
                QbftRound ->> RoundState: getProposedBlock()
                RoundState ->> QbftRound: returns QbftBlock or null
                QbftRound ->QbftRound: createCommitSeal(QbftBlock) return SECPSignature 
                opt There are times handling a proposed block is enough to enter prepared.
                  QbftRound->>QbftMessageTransmitter: multicastCommit(ConsensusRoundIdentifier, Hash, SECPSignature)
                end
                Note over QbftRound: can automatically add our commit message to the roundState <br/>cannot create a prepare message here, <br/>as it may be our proposal, <br/>and thus we cannot also prepare
                QbftRound ->> MessageFactory: createCommit(ConsensusRoundIdentifier, Hash, SECPSignature)
                MessageFactory ->> QbftRound: return Commit
                QbftRound ->> RoundState: addCommitMessage(Commit)
                opt It is possible sufficient commit seals are now available and the block should be imported
                  QbftRound ->> QbftRound: importBlockToChain()
                  QbftRound ->> QbftRound: notifyNewBlockListeneres(QbftBlock)
                end
              end
              QbftRound ->> QbftRound: sendPrepare(QbftBlock)
              QbftRound ->> MessageFactory: createPrepare(ConsensusRoundIdentifier, Hash)
              MessageFactory ->>QbftRound: creates a Prepare message
              QbftRound ->> QbftRound: peerIsPrepared(Prepare)
              RoundState ->> RoundState: addPrepareMessage(Prepare)
              QbftRound ->>QbftMessageTransmitter:multicastCommit(ConsensusRoundIdentifier, Hash, SECPSignature)
              QbftMessageTransmitter ->> UniqueMessageMulticaster: send()
              UniqueMessageMulticaster -->> OtherValidators: MESSAGE-COMMIT
              QbftRound ->>QbftMessageTransmitter:multicastPrepare(ConsensusRoundIdentifier, Hash)
              QbftMessageTransmitter ->> UniqueMessageMulticaster: send()
              UniqueMessageMulticaster -->> OtherValidators: MESSAGE-PREPARE
            else if not expired 
              QbftBlockHeightManager -> QbftFinalState: getBlockTimer().resetTimerForEmptyBlock(..)
              QbftBlockHeightManager -> QbftBlockHeightManager :  set currentRound as empty
            end
          end
        end
      end
    end
  end

  destroy BftEventQueue
  BftProcessor ->> BftEventQueue: stop()
  deactivate BftProcessor

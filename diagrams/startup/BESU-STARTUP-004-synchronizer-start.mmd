---
title: Synchronizer Flow

config:
  htmlLabels: false

  layout: elk
  theme: neutral
  look: handDrawn

  elk:
    mergeEdges: true
    nodePlacementStrategy: LINEAR_SEGMENTS
    nodePlacementAlignment: BALANCED
    keepEntryNodeOnTop: true

  flowchart:
    wrappingWidth: 350
    inheritDir: false

---
%%{init: {} }%%
flowchart
  subgraph "app"
    subgraph "Runner.java"
      startEthereumMainLoop(["`startEthereumMainLoop()`"])
    end
  end

  subgraph "ethereum"
    subgraph "eth"
      
      subgraph "SyncTerminationCondition.java"
        shouldContinueDonwload{"`shouldContinueDonwload()`"}
      end

      subgraph "SyncState.java"
        markInitialSyncPhaseAsDone("`markInitialSyncPhaseAsDone()`")
        setReachedTerminalDifficulty("`setReachedTerminalDifficulty()`")
      end

      subgraph "BlockPropagationManager.java"
        blockPropagationManager_start[["`start()`"]]
        setupListeners(["`setupListeners()`"])

        blockPropagationManager_start --> setupListeners -->listerners@{shape: brace, label: "Adds listeners like onBlockAdded, handleNewBlockFromNetwork, handleNewBlockHashesFromNetwork"}
      end

      subgraph "DefaultSynchronizer.java"
        defaultSynchronizer_start[["`start()`"]]
        startFullSync(["`startFullSync()`"])
        finalizeSync(["`finalizeSync()`"])
        fastSyncDownloader_present{"`fastSyncDownloader.isPresent()`"}
        handleSyncResult(["`handleSyncResult()`"])

        startFullSync --> finalizeSync
      end

      subgraph "SnapSyncDownloader.java"
        snapSyncDownloader_start[["`start()`"]]
        findPivotBlock(["`findPivotBlock()`"])
        selectPivotBlock(["`selectPivotBlock()`"])
        resolvePivotBlockHeader(["`resolvePivotBlockHeader()`"])
        updateMaxTrailingPeers(["`updateMaxTrailingPeers()`"])
        storeState(["`storeState()`"])
        downloadChainAndWorldState(["`downloadChainAndWorldState()`"])
        handleFailure(["`handleFailure()`"])

        snapSyncDownloader_start --> findPivotBlock .->selectPivotBlock .-> resolvePivotBlockHeader .-> updateMaxTrailingPeers .-> storeState .-> downloadChainAndWorldState .-> handleFailure
      end



      fastSyncDownloader_present .->|no| markInitialSyncPhaseAsDone@{shape: brace} .->|no| startFullSync
      defaultSynchronizer_start --> fastSyncDownloader_present .->|yes| snapSyncDownloader_start
      handleFailure .-> handleSyncResult --> shouldContinueDonwload --yes--> startFullSync
      shouldContinueDonwload -->|no| setReachedTerminalDifficulty@{shape: brace}
    end
  end

  defaultSynchronizer_start --> blockPropagationManager_start
  startEthereumMainLoop .-> defaultSynchronizer_start
